local p=game.Players.LocalPlayer
local c=p.Character or p.CharacterAdded:Wait()
local r=c:WaitForChild("HumanoidRootPart")
local h=c:WaitForChild("Humanoid")
local cam=workspace.CurrentCamera
local plrs=game:GetService("Players")
local rs=game:GetService("RunService")
local uis=game:GetService("UserInputService")

local flying=false
local flyCon=nil
local flySpeed=50
local noclip=false
local noclipCon=nil
local esp=false
local espCon=nil
local espCache={}
local ESP_REFRESH=0.5
local ESP_RANGE=500

local function startFly()
    if flying then return end
    flying=true
    workspace.Gravity=0
    flyCon=rs.Heartbeat:Connect(function()
        if not flying then return end
        if not c or not c.Parent then stopFly() return end
        local camLook=cam.CFrame.LookVector
        r.CFrame=CFrame.lookAt(r.Position,r.Position+camLook)
        local input=uis
        local move=Vector3.new(0,0,0)
        local f=r.CFrame.LookVector
        local ri=r.CFrame.RightVector
        if input:IsKeyDown(Enum.KeyCode.W) then move=move+f end
        if input:IsKeyDown(Enum.KeyCode.S) then move=move-f end
        if input:IsKeyDown(Enum.KeyCode.A) then move=move-ri end
        if input:IsKeyDown(Enum.KeyCode.D) then move=move+ri end
        if move.Magnitude>0 then move=move.Unit*flySpeed end
        r.Velocity=move
    end)
end
local function stopFly()
    if not flying then return end
    flying=false
    if flyCon then flyCon:Disconnect() flyCon=nil end
    workspace.Gravity=196.2
end
local function toggleNoclip()
    noclip=not noclip
    if noclip then
        noclipCon=rs.Heartbeat:Connect(function()
            if not noclip then return end
            if not c or not c.Parent then return end
            for _,part in ipairs(c:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide=false end
            end
        end)
    else
        if noclipCon then noclipCon:Disconnect() noclipCon=nil end
        for _,part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide=true end
        end
    end
end
local function findWeapon(char)
    if not char then return nil end
    for _,ch in ipairs(char:GetChildren()) do
        if ch:IsA("Tool") and ch:FindFirstChild("Handle") then
            local root=char:FindFirstChild("HumanoidRootPart")
            if root then
                local dist=(ch.Handle.Position-root.Position).Magnitude
                if dist<3 then
                    local n=ch.Name:lower()
                    if n:find("knife") or n:find("dagger") or n:find("blade") then return "knife" end
                    if n:find("gun") or n:find("pistol") or n:find("revolver") then return "gun" end
                end
            end
        end
    end
    return nil
end
local function updateESP()
    for _,t in ipairs(plrs:GetPlayers()) do
        if t==p then continue end
        local char=t.Character
        if not char or not char.Parent then
            local h=espCache[t]
            if h then pcall(h.Destroy) espCache[t]=nil end
            continue
        end
        local color=nil
        local w=findWeapon(char)
        if w=="knife" then color=Color3.fromRGB(255,0,0)
        elseif w=="gun" then color=Color3.fromRGB(0,128,255)
        else
            local root=char:FindFirstChild("HumanoidRootPart")
            if root and p.Character then
                local pr=p.Character:FindFirstChild("HumanoidRootPart")
                if pr and (root.Position-pr.Position).Magnitude<ESP_RANGE then color=Color3.fromRGB(0,255,0) end
            end
        end
        if color then
            local hl=espCache[t]
            if hl and hl.Parent then hl.FillColor=color hl.OutlineColor=color
            else
                hl=Instance.new("Highlight")
                hl.Name="ESP"
                hl.Parent=char
                hl.FillColor=color
                hl.FillTransparency=0.3
                hl.OutlineColor=color
                hl.OutlineTransparency=0
                hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                espCache[t]=hl
            end
        else
            local h=espCache[t]
            if h then pcall(h.Destroy) espCache[t]=nil end
        end
    end
end
local function enableESP()
    if esp then return end
    esp=true
    updateESP()
    espCon=rs.Heartbeat:Connect(function()
        if esp then
            if not espCon._lastUpdate or tick()-espCon._lastUpdate>ESP_REFRESH then
                updateESP()
                espCon._lastUpdate=tick()
            end
        end
    end)
end
local function disableESP()
    if not esp then return end
    esp=false
    if espCon then espCon:Disconnect() espCon=nil end
    for _,h in pairs(espCache) do pcall(h.Destroy) end
    espCache={}
end
local function autoGun()
    local guns={}
    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Tool") then
            local n=obj.Name:lower()
            if n:find("gun") or n:find("pistol") or n:find("revolver") or n:find("rifle") then
                table.insert(guns,obj)
            end
        end
    end
    if #guns==0 then print("Brak pistoletu") return end
    local closest=nil
    local closestDist=math.huge
    local myPos=r.Position
    for _,gun in ipairs(guns) do
        local gp=gun:FindFirstChild("Handle") and gun.Handle.Position or gun.Position
        local d=(gp-myPos).Magnitude
        if d<closestDist then closestDist=d closest=gun end
    end
    if closest then
        local gp=closest:FindFirstChild("Handle") and closest.Handle.Position or closest.Position
        r.CFrame=CFrame.new(gp+Vector3.new(0,2,0))
        task.wait(0.1)
        local root=c:FindFirstChild("HumanoidRootPart")
        if root then
            local te=Instance.new("TouchTransmitter")
            te.Parent=closest
            te:Fire(root)
            task.wait(0.1)
            te:Destroy()
        end
        print("Podniesiono: "..closest.Name)
    end
end
uis.InputBegan:Connect(function(input,gp)
    if gp then return end
    if input.KeyCode==Enum.KeyCode.X then if flying then stopFly() else startFly() end end
    if input.KeyCode==Enum.KeyCode.Z then toggleNoclip() end
    if input.KeyCode==Enum.KeyCode.C then if esp then disableESP() else enableESP() end end
    if input.KeyCode==Enum.KeyCode.V then autoGun() end
end)
p.CharacterAdded:Connect(function(nc)
    c=nc
    r=c:WaitForChild("HumanoidRootPart")
    h=c:WaitForChild("Humanoid")
    if flying then stopFly() end
    if noclip then
        noclip=false
        if noclipCon then noclipCon:Disconnect() noclipCon=nil end
        for _,part in ipairs(c:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide=true end
        end
    end
    if esp then disableESP() task.wait(0.3) enableESP() end
end)
print("=== ZAŁADOWANE ===")
print("X=Fly Z=Noclip C=ESP V=AutoPistol")
